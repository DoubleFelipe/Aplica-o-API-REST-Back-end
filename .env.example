# Servidor
NODE_ENV=development
PORT=3000

# URL exata do front-end autorizado (sem barra final)
FRONTEND_URL=http://localhost:5173
# URL pública da API (necessária para usar o Swagger hospedado em produção)
API_URL=http://localhost:3000

# JWT: use um valor longo e aleatório em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# PostgreSQL local ou Aiven. Para Aiven use a connection string fornecida pelo serviço.
# A aplicação controla TLS pela variável DATABASE_SSL.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORT/BANCO
DATABASE_SSL=true
