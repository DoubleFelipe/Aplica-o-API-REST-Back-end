# Servidor
NODE_ENV=development
PORT=3000

# URL exata do front-end autorizado (sem barra final)
FRONTEND_URL=http://localhost:5173

# JWT: use um valor longo e aleatório em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h

# PostgreSQL local ou Aiven. Para Aiven use a connection string fornecida pelo serviço.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:PORT/BANCO?sslmode=require
DATABASE_SSL=true
